# Normalize all text files to LF on commit
* text=auto

# Kotlin / Gradle / config source files — enforce LF
*.kt     text eol=lf
*.kts    text eol=lf
*.xml    text eol=lf
*.toml   text eol=lf
*.properties text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.pro    text eol=lf

# Windows batch — must keep CRLF
*.bat    text eol=crlf

# Binary assets — do not mangle
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.svg    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.apk    binary
*.aab    binary
*.jks    binary
*.keystore binary
*.zip    binary
*.jar    binary
*.aar    binary
